{
  "name": "relay",
  "version": "0.3.3",
  "repository": "nikhlgoel/whatsapp-pc",
  "description": "Relay - a native Windows desktop client for WhatsApp",
  "productName": "Relay",
  "main": "src/main.js",
  "author": "nikhlgoel",
  "license": "MIT",
  "scripts": {
    "prestart": "node tools/brand-electron.js",
    "start": "electron .",
    "prestart:debug": "node tools/brand-electron.js",
    "start:debug": "electron . --remote-debugging-port=9222",
    "test": "node --test \"test/*.test.js\"",
    "icons": "electron tools/make-icons.js",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir",
    "predist": "node tools/get-node.js",
    "prepack": "node tools/get-node.js"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "publish": [
      {
        "provider": "github"
      }
    ],
    "appId": "com.nikhlgoel.relay",
    "productName": "Relay",
    "directories": {
      "output": "dist",
      "buildResources": "src/assets"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/@fugood/node-llama-win32-x64-cuda/**",
      "!node_modules/@fugood/node-llama-wasm/**",
      "!node_modules/@fugood/llama.node/src/**",
      "!node_modules/@fugood/*/**/*.md"
    ],
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Relay",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "uninstallDisplayName": "Relay",
      "artifactName": "RelayInstaller${version}.${ext}",
      "include": "src/assets/installer.nsh"
    },
    "portable": {
      "artifactName": "Relay-portable-${version}.exe"
    },
    "copyright": "Copyright (c) 2026 nikhlgoel",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "asarUnpack": [
      "node_modules/@fugood/**/*",
      "src/voice-engine.js",
      "src/voice-ipc.js",
      "src/voice/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/onnxruntime-common/**/*",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*",
      "node_modules/adm-zip/**/*",
      "node_modules/global-agent/**/*",
      "node_modules/matcher/**/*",
      "node_modules/semver/**/*",
      "node_modules/serialize-error/**/*",
      "node_modules/type-fest/**/*",
      "node_modules/escape-string-regexp/**/*",
      "node_modules/globalthis/**/*",
      "node_modules/define-properties/**/*",
      "node_modules/define-data-property/**/*",
      "node_modules/es-define-property/**/*",
      "node_modules/es-errors/**/*",
      "node_modules/gopd/**/*",
      "node_modules/object-keys/**/*"
    ],
    "extraResources": [
      {
        "from": "tools/runtime/node.exe",
        "to": "node/node.exe"
      }
    ]
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  },
  "optionalDependencies": {
    "@fugood/llama.node": "^1.7.15",
    "@fugood/node-llama-win32-x64-vulkan": "^1.7.15",
    "@fugood/node-whisper-win32-x64-vulkan": "1.2.0-rc.1",
    "onnxruntime-node": "^1.30.0",
    "sherpa-onnx-node": "^1.13.8"
  },
  "engines": {
    "node": ">=22"
  }
}
