{
  "name": "relay",
  "version": "0.2.2",
  "repository": "nikhlgoel/whatsapp-pc",
  "description": "Relay - a native Windows desktop client for WhatsApp",
  "productName": "Relay",
  "main": "src/main.js",
  "author": "white.dev.sc",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --remote-debugging-port=9222",
    "test": "node --test \"test/*.test.js\"",
    "icons": "electron tools/make-icons.js",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "publish": [
      {
        "provider": "github"
      }
    ],
    "appId": "com.nikhlgoel.relay",
    "productName": "Relay",
    "directories": {
      "output": "dist",
      "buildResources": "src/assets"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Relay"
    },
    "portable": {
      "artifactName": "Relay-portable-${version}.exe"
    }
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  }
}
